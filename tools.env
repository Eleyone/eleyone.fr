# Versions et empreintes épinglées du projet (AD-1). Seule déclaration : aucune version ni empreinte
# n'est écrite ailleurs dans le dépôt. Monter une version consiste à modifier ce seul fichier, puis à
# relancer scripts/ci/install-tools.sh (--local sur le poste).
#
# Empreintes calculées depuis les archives officielles et recoupées avec les fichiers de sommes publiés
# par les deux projets (hugo_<version>_checksums.txt, SHA256SUMS), le 16/09/2026.
# Format : une variable par ligne, VALEUR sans guillemets, lu ligne à ligne par scripts/lib/tools.sh.

HUGO_VERSION=0.166.0
HUGO_ARCHIVE=hugo_0.166.0_linux-amd64.tar.gz
HUGO_URL=https://github.com/gohugoio/hugo/releases/download/v0.166.0/hugo_0.166.0_linux-amd64.tar.gz
HUGO_SHA256=45228f5a52eb118b0ca168068f01d7df0447314a24056f1d29667ed9fc368308

D2_VERSION=0.9.0
D2_ARCHIVE=d2-v0.9.0-linux-amd64.tar.gz
D2_URL=https://github.com/terrastruct/d2/releases/download/v0.9.0/d2-v0.9.0-linux-amd64.tar.gz
D2_SHA256=5669ddc46b99e942cc96078f4a4e36d5e62103348f4c05179ede27802fdd87a9

# Image de contrôle des deux CI et de l'étape « tools » du Dockerfile : alpine:3.24 épinglée par digest.
CHECK_IMAGE=alpine@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

# Paquets installés par apk dans l'image (jamais sur le poste), en trois temps, parce qu'alpine:3.24
# n'a ni bash, ni curl, ni certificats : leur réunion est la liste des outils de contrôle d'AD-1
# (bash, git, grep et findutils GNU, jq, libxml2-utils, poppler-utils) plus les prérequis du job.
#   1. amorçage, posé par scripts/ci/install-tools-bootstrap.sh, qui est en sh POSIX
CHECK_BOOTSTRAP_PACKAGES=bash
#   2. prérequis du job : le téléchargement (curl, certificats) et la bascule vers le compte de
#      l'appelant en fin d'installation (su-exec, story 3.12 : apk exige root, mais ce que le job
#      écrit dans le dépôt monté ne doit pas appartenir à root)
CHECK_BASE_PACKAGES=curl ca-certificates su-exec
#   3. outils de contrôle ; grep et findutils sont ceux de GNU, pour que le poste et l'image se
#      comportent pareil : le find de BusyBox ignore -printf, dont scripts/tests/run.sh se sert
#      pour relever l'état de public/ et de build/ (constaté story 3.12)
CHECK_PACKAGES=git grep findutils jq libxml2-utils poppler-utils
