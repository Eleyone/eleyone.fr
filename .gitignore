# Sources privées (cas bruts, noyau narratif, mémoire des réunions) : jamais versionnées
docs/private/

# Valeurs d'environnement (mentions légales, secrets) : seul .env.example est versionné
.env

# Worktrees temporaires des agents
.claude/worktrees/

# Artefacts de téléchargement Windows
*:Zone.Identifier

# Corps de PR de scripts/create-pull-request.sh, réécrit à chaque PR
.pr-body.md

# Outils épinglés installés en local par scripts/ci/install-tools.sh --local (AD-1, D-15)
.tools/

# Sorties de Hugo
public/
build/
resources/_gen/
.hugo_build.lock
