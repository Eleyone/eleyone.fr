# Sources privées (cas bruts, noyau narratif, mémoire des réunions) : jamais versionnées
docs/private/

# Valeurs d'environnement (mentions légales, secrets) : seul .env.example est versionné
.env

# Worktrees temporaires des agents
.claude/worktrees/

# Artefacts de téléchargement Windows
*:Zone.Identifier

# Corps de PR de .working-method/gitea/create-pull-request.sh, réécrit à chaque PR
.pr-body.md

# Outils épinglés installés en local par scripts/ci/install-tools.sh --local (AD-1, D-15)
.tools/

# Sorties de Hugo
public/
build/
resources/_gen/
.hugo_build.lock
.agents/mcp_config.json

# BMAD (story outillage-1 du dépôt commun) : configuration générée par .working-method/bin/install depuis
# workflow.config ET _bmad/config.user.toml, propre à chaque poste ; et la couche utilisatrice elle-même
# (décisions d'Arnaud des 04 et 05/10/2026). bin/install exige _bmad/config.user.toml et ne l'écrit jamais.
/_bmad/*/config.yaml
/_bmad/config.user.toml
