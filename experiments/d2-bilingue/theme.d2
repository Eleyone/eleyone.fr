# Thème sobre proposé pour le portfolio, partagé par tous les schémas.
# Base : Neutral Grey (1). Surcharges : encre ardoise, fonds quasi blancs,
# un seul accent (bleu ardoise) pour les bordures et les liens.
# Palette D2 : N* = neutres (N1 texte principal … N7 fond), B* = couleur
# de base (B1 bordures … B6 fonds de conteneurs), AA*/AB* = accents.
vars: {
  d2-config: {
    theme-id: 1
    theme-overrides: {
      N1: "#1F2933"
      N2: "#3E4C59"
      N3: "#616E7C"
      N4: "#D9E2EC"
      N5: "#CBD2D9"
      N6: "#E4E7EB"
      N7: "#FFFFFF"
      B1: "#334E68"
      B2: "#486581"
      B3: "#9FB3C8"
      B4: "#D9E2EC"
      B5: "#F0F4F8"
      B6: "#F8FAFC"
      AA2: "#486581"
      AA4: "#D9E2EC"
      AA5: "#F0F4F8"
      AB4: "#E4E7EB"
      AB5: "#F5F7FA"
    }
  }
}
