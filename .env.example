# Copier ce fichier en .env à la racine du dépôt, puis renseigner les valeurs avec un éditeur.
# .env n'est jamais commité : il est ignoré par git et refusé par scripts/check-private.sh.
# Procédure : docs/procedures/gitea-token.md
# Une valeur qui contient une espace se met entre guillemets : HUGO_LEGAL_PUBLISHER_NAME="Prénom Nom".
# Les scripts lisent ce fichier ligne par ligne (CLÉ=VALEUR) ; ils ne le chargent jamais avec source.

# API de la forge (poste de dev uniquement).
# En CI, les jobs utilisent le jeton automatique de Gitea : le préfixe GITEA_ est réservé aux secrets.
GITEA_URL=
GITEA_USER=
GITEA_TOKEN=

# Mentions légales (AD-9) : lues au build, jamais commitées, exigées par le build de production.
HUGO_LEGAL_PUBLISHER_NAME=
HUGO_LEGAL_PUBLISHER_ADDRESS=
HUGO_LEGAL_PUBLISHER_EMAIL=
HUGO_LEGAL_PUBLISHER_PHONE=
HUGO_LEGAL_PUBLISHER_REGISTRATION=
HUGO_LEGAL_HOST_NAME=
HUGO_LEGAL_HOST_ADDRESS=
HUGO_LEGAL_HOST_PHONE=
