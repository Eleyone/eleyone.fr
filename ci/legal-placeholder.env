# Valeurs factices des mentions légales (AD-9), commitées et employées par tout build de contrôle :
# poste sans .env, job de contrôles de Gitea, CI publique de GitHub. Chaque valeur porte VALEUR-FACTICE,
# pour qu'une page légale construite avec elles se reconnaisse au premier coup d'œil.
# Une mise en ligne les refuse : ENV_MODE=release exige un fichier de secrets dédié.
HUGO_LEGAL_PUBLISHER_NAME=VALEUR-FACTICE-editeur-nom
HUGO_LEGAL_PUBLISHER_ADDRESS=VALEUR-FACTICE-editeur-adresse
HUGO_LEGAL_PUBLISHER_EMAIL=contact@VALEUR-FACTICE.invalid
HUGO_LEGAL_PUBLISHER_PHONE=+33 0 00 00 00 00 VALEUR-FACTICE
HUGO_LEGAL_PUBLISHER_REGISTRATION=VALEUR-FACTICE-editeur-immatriculation
HUGO_LEGAL_HOST_NAME=VALEUR-FACTICE-hebergeur-nom
HUGO_LEGAL_HOST_ADDRESS=VALEUR-FACTICE-hebergeur-adresse
HUGO_LEGAL_HOST_PHONE=+33 0 00 00 00 00 VALEUR-FACTICE
