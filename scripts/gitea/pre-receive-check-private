#!/usr/bin/env bash
# Hook pre-receive du dépôt du site sur Gitea : lance le garde-fou public/privé avec la liste des motifs.
#
# À poser, droits 0755 et propriétaire git, dans <dépôt nu>/hooks/pre-receive.d/check-private.
# Le hook pre-receive généré par Gitea lance chaque script de pre-receive.d avec l'entrée standard reçue.
# Le script du garde-fou et la liste des motifs vivent sous $GITEA_CUSTOM/eleyone-check-private/, dans le
# volume de données de Gitea : aucun chemin du serveur n'est écrit ici. Tout doute refuse le push.
# Procédure : docs/procedures/gitea-pre-receive-hook.md
set -euo pipefail

refuse() { printf 'check-private: %s : push refusé.\n' "$1" >&2; exit 1; }

[[ -n ${GITEA_CUSTOM:-} ]] || refuse "GITEA_CUSTOM non définie, dossier du garde-fou introuvable"
dir="$GITEA_CUSTOM/eleyone-check-private"
script="$dir/check-private.sh"
list="$dir/forbidden-patterns.txt"
# La bibliothèque de lecture d'images porte C20, que le hook applique depuis la story 5.4 : sans
# elle, une image porteuse de métadonnées passerait, et le miroir la publierait dans la seconde.
# Elle est vérifiée ici pour que le refus nomme ce qui manque, plutôt que de laisser le garde-fou
# échouer sur un « source: fichier introuvable ».
lib="$dir/lib/image.sh"
# Même règle pour la lecture des PDF depuis la story 7.3 : sans elle, le texte et les métadonnées
# d'un CV ne seraient lus par personne, et le miroir publierait dans la seconde.
lib_pdf="$dir/lib/pdf.sh"
[[ -f $script && -r $script ]] || refuse "script du garde-fou absent ou illisible"
[[ -f $lib && -r $lib ]] || refuse "bibliothèque de lecture d'images absente ou illisible"
[[ -f $lib_pdf && -r $lib_pdf ]] || refuse "bibliothèque de lecture des PDF absente ou illisible"
[[ -f $list && -r $list ]] || refuse "liste des motifs absente ou illisible"
# poppler est vérifié ici pour que le refus nomme le paquet, plutôt que de laisser le garde-fou
# échouer sur une commande introuvable au milieu d'un push.
for outil in pdftotext pdfinfo; do
  command -v "$outil" > /dev/null 2>&1 \
    || refuse "$outil absent (paquet poppler-utils) : un CV PDF ne pourrait pas être lu"
done

PRIVATE_PATTERNS_FILE=$list exec bash "$script" pre-receive
