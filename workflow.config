# Ce qui est propre à eleyone.fr pour l'outillage commun (sous-module .working-method). Schéma 2.
# Format et sens de chaque champ : .working-method/procedures/workflow-config.md. Tous les champs sont
# obligatoires : un champ absent, inconnu, en double ou vide fait refuser le fichier (code 2).
# Les valeurs reprennent ce que l'outillage lisait en dur avant son extraction (story outillage-14 du
# dépôt de la calculatrice, phase C) : le comportement des gates est inchangé.

[workflow]
	schema = 2

[forge]
	repo = Eleyone/eleyone.fr
	base = dev
	# main reçoit dev par le skill release, un correctif de production par le skill hotfix : aucune PR
	# n'y est ouverte ni fusionnée par l'outillage commun
	release-branch = main
	branch-prefixes = feat fix chore docs
	env-file = .env

[sprint]
	convention = numbered
	status-file = _bmad-output/implementation-artifacts/sprint-status.yaml
	stories-dir = _bmad-output/implementation-artifacts
	spec-source = _bmad-output/planning-artifacts/epics.md

[review]
	# exception documentaire (AGENTS.md, point 3) : une PR dont tous les fichiers sont sous _bmad-output/
	exempt-paths = ^_bmad-output/
	report = pr-comment
	reviewer-for-claude = gemini-3.1-pro-high
	reviewer-for-gemini = claude-opus-4-6-thinking
	timeout = 900
	project-layer = scripts/review/project-layer.md
	private-paths = .env docs/private .pr-body.md
	# le diff d'une revue de plage écarte les artefacts de cadrage : leur volume noierait le code
	range-exclude = _bmad-output

[guard]
	command = scripts/check-private.sh
	patterns-file = docs/private/forbidden-patterns.txt

[ci]
	workflow = .gitea/workflows/checks.yaml
	status-context = checks
	# règle d'amorçage (AGENTS.md, point 6) : sans effet depuis que checks.yaml existe sur dev
	bootstrap = true

[checks]
	command = scripts/check.sh
	dir = scripts/checks

[tests]
	# sorties de build que la suite de tests ne doit jamais toucher
	protected-outputs = public build

[bmad]
	# la version de BMAD du sous-module (.working-method/bmad/bmad.config) : sinon bin/install rend 1
	version = 6.12.0
	# modules activés parmi l'union du sous-module ; ni tea ni wds (aucun usage dans ce dépôt)
	modules = core bmm bmb cis bmad-loop
	# valeurs de la configuration BMAD générée par bin/install (_bmad/config.toml, _bmad/<module>/config.yaml).
	# La langue des documents reste « English » à la génération, comme le faisait l'installeur :
	# _bmad/custom/config.toml la passe en français par-dessus.
	project-name = eleyone.fr
	document-output-language = English
	output-folder = _bmad-output

[agents]
	skill-dirs = .claude/skills .agents/skills .agent/skills
